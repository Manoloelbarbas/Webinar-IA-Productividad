# Puerto local del backend Express
PORT=3000

# URL base de Ollama (asegúrate de tener `ollama serve` corriendo)
OLLAMA_BASE_URL=http://localhost:11434

# Modelo de Ollama a utilizar.
# Descargar previamente con: ollama pull <modelo>
# Recomendados:
#   llama3.2:3b              -> rápido, corre en CPU con 8GB RAM
#   qwen2.5:7b-instruct      -> mejor calidad de tablas y formato (necesita 16GB RAM o GPU)
#   mistral:7b-instruct      -> alternativa equilibrada
OLLAMA_MODEL=llama3.2:3b

# Tiempo máximo de espera para una respuesta de Ollama (ms).
# CPU + modelos 7B pueden tardar varios minutos en transcripciones largas.
OLLAMA_TIMEOUT_MS=180000

# Tamaño máximo aceptado de la transcripción (caracteres).
MAX_TRANSCRIPT_CHARS=50000
